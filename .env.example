# RTX 5090 Stock Tracker Environment Variables

# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rtx_tracker

# Email alert settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
FROM_EMAIL=your-email@gmail.com
TO_EMAIL=your-email@gmail.com

# Alert settings
ALERT_PRICE_THRESHOLD=2500

# Monitoring settings (in minutes)
MONITORING_INTERVAL=60

# Web dashboard settings
PORT=5003
DEBUG=True

# S3 settings (enable to store images in S3 instead of locally)
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=